# Servidor
PORT=3333
NODE_ENV=development

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
DEFAULT_TEMPORARY_PASSWORD=change-me
INVENTORY_INTERNAL_TOKEN=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zytrex_inventory
DB_USER=cinepolis_estacao
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# CORS - origens permitidas, separadas por vírgula. Use * para liberar tudo.
CORS_ORIGIN=*

# Zytrex Scale webhook
SCALE_WEBHOOK_ENABLED=true
SCALE_WEBHOOK_URL=http://localhost:3333/api/sync/inventory/usuario
SCALE_WEBHOOK_TOKEN=

# Email SMTP para alertas diarios de validade
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VALIDADE_ALERTA_EMAIL_HORARIO=08:00
